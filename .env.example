# ============================================================
# ParkFlow - Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ============================================================

# Database Configuration (PostgreSQL)
DB_NAME=parking_db
DB_USER=parking_user
DB_PASSWORD=your_secure_db_password_here

# Backend Security (Spring Boot & JWT)
# Minimum 256-bit (32 bytes) Base64-encoded secret
JWT_SECRET=your_jwt_secret_base64_encoded_256_bit_minimum
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080

# Monitoring & Dashboards (Grafana)
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password_here
