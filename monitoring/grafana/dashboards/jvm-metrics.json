      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (action) (rate(jvm_gc_pause_seconds_sum{job=\"parkflow-backend\"}[1m]))",
          "legendFormat": "GC Pause Duration - {{action}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
